generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum QualityCaseStatus {
  DRAFT
  INVESTIGATING
  RESOLVED
}

model QualityCase {
  id                    String            @id @default(cuid())
  status                QualityCaseStatus @default(DRAFT)
  problem               String
  productionStage       String?
  productModelReference String?
  material              String?
  machineWorkstation    String?
  batchOrderReference   String?
  additionalContextNote String?
  evidence              Evidence[]
  contributingCauses    ContributingCause[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([status, updatedAt])
}

model Evidence {
  id            String              @id @default(cuid())
  qualityCaseId String
  content       String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  qualityCase   QualityCase         @relation(fields: [qualityCaseId], references: [id], onDelete: Cascade)
  causeLinks    EvidenceCauseLink[]

  @@index([qualityCaseId, createdAt])
}

model ContributingCause {
  id            String              @id @default(cuid())
  qualityCaseId String
  content       String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  qualityCase   QualityCase         @relation(fields: [qualityCaseId], references: [id], onDelete: Cascade)
  evidenceLinks EvidenceCauseLink[]

  @@index([qualityCaseId, createdAt])
}

model EvidenceCauseLink {
  evidenceId          String
  contributingCauseId String
  evidence            Evidence          @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  contributingCause   ContributingCause @relation(fields: [contributingCauseId], references: [id], onDelete: Cascade)

  @@id([evidenceId, contributingCauseId])
  @@index([contributingCauseId])
}
