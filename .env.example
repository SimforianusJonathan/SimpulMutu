# Canonical PostgreSQL connection used by Prisma and the application.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/itechno_quality_memory"

# One demo credential. This value is validated only on the server.
APP_ACCESS_CREDENTIAL="replace-with-a-private-demo-credential"

# Use at least 32 characters. Rotate this independently from the access credential.
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters"
